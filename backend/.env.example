# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://almaha:almaha_dev@localhost:5432/almahafarm
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (required - must be at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=30
APP_VERSION=0.1.0

# Platform super-admins (comma-separated emails; can create orgs and switch tenants)
SUPER_ADMIN_EMAILS=you@example.com

# External APIs
OPENWEATHER_API_KEY=your-openweather-api-key
SENTINELHUB_INSTANCE_ID=your-instance-id
SENTINELHUB_WMS_URL=https://services.sentinel-hub.com/ogc/wms/your-instance-id
SENTINELHUB_CLIENT_ID=your-client-id
SENTINELHUB_CLIENT_SECRET=your-client-secret
WEATHERSTATION_API_BASE_URL=https://api.your-weather-station.com
WEATHERSTATION_API_KEY=your-weatherstation-api-key
WEATHERSTATION_API_HEADER=x-api-key

# Logging
LOG_LEVEL=info

# Error Tracking (optional - leave empty to disable)
SENTRY_DSN=
APP_VERSION=0.1.0

# Microsoft SSO (Azure AD) - optional
# Get these from Azure Portal > App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Email (SMTP) - for password reset and notifications
# Can use Office 365, Gmail, SendGrid, etc.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourcompany.com

# App URL (for email links)
APP_URL=http://localhost:3000

# Background jobs
JOBS_ENABLED=false

# CORS
CORS_ORIGIN=http://localhost:3000
