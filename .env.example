# OpenWeatherMap API Configuration
# Get your free API key from: https://openweathermap.org/api
# 
# Steps to enable automatic weather fetching:
# 1. Sign up at https://openweathermap.org/api (free tier available)
# 2. Get your API key from the dashboard
# 3. Copy this file to .env (remove .example)
# 4. Replace 'your_api_key_here' with your actual API key
# 5. Restart your development server

REACT_APP_OPENWEATHER_API_KEY=your_api_key_here

# SentinelHub Configuration
# Get your credentials from: https://www.sentinel-hub.com/
#
# Option 1: WMS Configuration (Simpler)
# - Get your WMS URL from SentinelHub dashboard
# - Or use Instance ID to auto-construct WMS URL
REACT_APP_SENTINELHUB_WMS_URL=your_wms_url_here
# OR
REACT_APP_SENTINELHUB_INSTANCE_ID=your_instance_id_here

# Option 2: Process API Configuration (More Features)
# - Create OAuth client in SentinelHub dashboard
# - Get Client ID and Client Secret
REACT_APP_SENTINELHUB_CLIENT_ID=your_client_id_here
REACT_APP_SENTINELHUB_CLIENT_SECRET=your_client_secret_here

# Backend API URL
REACT_APP_API_URL=http://localhost:3001/api/v1

# App version — set to match backend APP_VERSION on deploy (shows update banner when they differ)
REACT_APP_VERSION=0.1.0

# Error Tracking (optional - leave empty to disable)
REACT_APP_SENTRY_DSN=
