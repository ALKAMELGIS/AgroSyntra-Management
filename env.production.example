# Production env for docker-compose.prod.yml
# Copy to .env.production (or set in CI) and fill in. Never commit real values.

# Required
POSTGRES_PASSWORD=        # Strong password for Postgres
JWT_SECRET=              # At least 32 chars; e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORS_ORIGIN=             # Your frontend URL only, e.g. https://app.almahafarm.com

# Optional — leave empty to use defaults
POSTGRES_USER=almaha
POSTGRES_DB=almahafarm

# Optional — error tracking
BACKEND_SENTRY_DSN=      # Sentry DSN for backend

# Optional — external APIs (leave empty if not used)
OPENWEATHER_API_KEY=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Optional — override images (default: ghcr.io/your-org/al-maha-farm/backend:latest etc.)
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
